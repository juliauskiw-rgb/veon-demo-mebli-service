---
// Functional line icons only (concept §5 «Іконки»): 1.5 px stroke, current text colour.
type Name = "phone" | "viber" | "whatsapp" | "mail" | "menu" | "close" | "back" | "next" | "plus";
interface Props { name: Name; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5.5 3.5h3l1.5 4-2 1.25a11 11 0 0 0 5.25 5.25L14.5 12l4 1.5v3a2 2 0 0 1-2 2A13 13 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z" />}
  {name === "viber" && (
    <>
      <path d="M12 3c4.6 0 8 1.6 8 7.2 0 5.3-3.1 7-7.6 7l-3.4 3.3v-3.6C5.6 16 4 13.8 4 10.2 4 4.6 7.4 3 12 3Z" />
      <path d="M9.6 7.6c.4-.3.9-.2 1.1.2l.6 1.2c.2.4 0 .8-.3 1l-.4.3c.4 1 1.2 1.8 2.2 2.2l.3-.4c.2-.3.7-.5 1-.3l1.2.6c.4.2.5.7.2 1.1-.5.7-1.2 1-2 .8-2-.6-3.9-2.4-4.5-4.5-.2-.8.1-1.6.6-2.2Z" />
    </>
  )}
  {name === "whatsapp" && (
    <>
      <path d="M4.5 20l1.2-3.9A8.2 8.2 0 1 1 8.6 19l-4.1 1Z" />
      <path d="M9.4 8.2c.3-.3.8-.3 1 .1l.6 1.3c.1.3 0 .6-.2.8l-.4.4c.5 1.1 1.4 2 2.6 2.6l.4-.4c.2-.2.5-.3.8-.2l1.3.6c.4.2.4.7.1 1-.5.6-1.3.9-2.1.7-2.1-.6-3.9-2.4-4.5-4.5-.2-.8.1-1.6.4-2.4Z" />
    </>
  )}
  {name === "mail" && (<><rect x="3.5" y="5.5" width="17" height="13" rx="1.5" /><path d="m4 6.5 8 6 8-6" /></>)}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "back" && <path d="M15 5l-7 7 7 7" />}
  {name === "next" && <path d="M9 5l7 7-7 7" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
</svg>
