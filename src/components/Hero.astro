---
// First screen (concept §8.3): full-width H1, action column + a real work photo; the signature sentence sits
// under the actions in the left column on desktop (fills the fold, hallmark-finish §2) and after the photo on phones.
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import heroPhoto from "../assets/photos/hero-dyvan.jpg";
import { contacts, inventory } from "../data/site";
---
<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="container">
    <header class="hero__head">
    <h1 id="hero-title" class="hero__title" data-rec="R-012">
      <span class="hero__line"><span>Перетяжка меблів</span></span>
      <span class="hero__line"><span>у Львові</span></span>
    </h1>

    <div class="hero__grid">
      <div class="hero__action" data-rec="R-002,GA-R007">
        <p class="hero__offer">Перетягуємо, ремонтуємо і чистимо м'які меблі, крісла й сидіння авто. Львів і область.</p>
        <div class="hero__buttons">
          <a class="btn btn--primary hero__viber" href={contacts.viber}><Icon name="viber" />Надіслати фото у Viber</a>
          <a class="btn btn--secondary" href={contacts.whatsapp}><Icon name="whatsapp" />WhatsApp</a>
          <a class="btn btn--secondary hero__call" href={contacts.phoneMain.href}><Icon name="phone" />Подзвонити</a>
        </div>
        <p class="hero__phone">
          <a class="text-link tnum" href={contacts.phoneMain.href}>{contacts.phoneMain.display}</a>
        </p>
        <p class="hero__hours">{contacts.hours}</p>
      </div>

      <figure class="hero__photo" data-rec="R-019">
        <div class="hero__frame">
          <Picture
            src={heroPhoto}
            alt="Двомісний диван після перетяжки в замшеву тканину пісочного кольору"
            widths={[480, 720, 1024]}
            sizes="(min-width: 1280px) 690px, (min-width: 1024px) 56vw, calc(100vw - 48px)"
            formats={["webp"]}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption>Диван після перетяжки</figcaption>
      </figure>
      <p class="hero__inventory">
        Беремо в роботу {inventory.map((it, i) => (
          <>
            <a class="inv-link" href={it.href}>{it.text}</a>{i < inventory.length - 2 ? ", " : i === inventory.length - 2 ? " й " : "."}
          </>
        ))}
      </p>
    </div>
    </header>

  </div>
</section>

<style>
  .hero { padding-block: var(--s-4) var(--s-5); }
  .hero__title { font-size: var(--fs-6); font-weight: 500; letter-spacing: -0.025em; line-height: 1.02; max-width: 11ch; }
  .hero__line { display: block; }
  .hero__line > span { display: inline-block; }

  .hero__grid { display: grid; gap: var(--s-4); margin-top: var(--s-3); }
  .hero__offer { font-size: var(--fs-2); line-height: 1.5; max-width: 34ch; }
  .hero__buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-1); margin-top: var(--s-3); }
  .hero__viber { grid-column: 1 / -1; min-height: 3.5rem; font-size: var(--fs-2); }
  .hero__buttons .btn { padding-inline: var(--s-2); }
  .hero__phone { display: none; margin-top: var(--s-2); font-size: var(--fs-3); font-weight: 500; }
  .hero__hours { margin-top: var(--s-2); color: var(--color-muted); font-size: var(--fs-cap); }

  .hero__photo { min-width: 0; }
  .hero__frame { overflow: clip; aspect-ratio: 4 / 3; background: var(--color-line); }
  .hero__frame :global(picture) { height: 100%; }
  .hero__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__photo figcaption { margin-top: var(--s-1); font-size: var(--fs-cap); color: var(--color-muted); }

  .hero__inventory { margin-top: var(--s-2); font-family: var(--font-display); font-size: clamp(1.625rem, 1.2rem + 1.9vw, 2.5rem); line-height: 1.3; letter-spacing: -0.01em; max-width: 30ch; text-wrap: pretty; }
  .inv-link { position: relative; z-index: 0; display: inline-block; text-decoration: none; color: var(--color-text); white-space: nowrap; }
  .inv-link::before { content: ""; position: absolute; z-index: -1; left: -0.06em; right: -0.06em; bottom: 0.04em; height: 1.05em; background: var(--color-accent); transform: scaleY(0.1); transform-origin: bottom; transition: transform 220ms var(--ease-out); }
  .inv-link:hover::before, .inv-link:focus-visible::before { transform: scaleY(1); }

  /* The sentence is in the first screen: shown once the display font is in, so the swap does not re-wrap it (CLS 0).
     Without scripts .js is absent and it is always visible; Base.astro adds .fonts-ready after 1.5 s at most. */
  :global(.js:not(.fonts-ready)) .hero__inventory { visibility: hidden; }

  @media (max-width: 359px) {
    .hero__buttons .btn:not(.hero__viber) { gap: .375rem; padding-inline: .5rem; }
  }
  @media (min-width: 768px) {
    .hero { padding-top: var(--s-5); }
    .hero__offer { min-height: 4.5em; } /* 3 lines of Golos: the body-font swap does not push the buttons (CLS 0) */
    .hero__buttons { display: flex; flex-wrap: wrap; }
    .hero__viber { font-size: var(--fs-1); }
    .hero__call { display: none; }
    .hero__phone { display: block; }
  }
  @media (min-width: 1024px) {
    .hero__title { max-width: none; }
    .hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); margin-top: var(--s-5); align-items: start; }
    .hero__grid { grid-template-rows: auto 1fr; row-gap: 0; }
    .hero__action { grid-column: 1 / span 5; grid-row: 1; padding-top: var(--s-1); }
    .hero__photo { grid-column: 6 / -1; grid-row: 1 / span 2; }
    .hero__frame { aspect-ratio: 3 / 2; }
    .hero__inventory { grid-column: 1 / span 5; grid-row: 2; align-self: start; margin-top: var(--s-4); padding-top: var(--s-3); border-top: 1px solid var(--color-line); font-size: clamp(1.375rem, 0.9rem + 0.8vw, 1.75rem); max-width: none; }
  }

  /* Motion 1: H1 rises line by line inside its mask, the photo opens from below. Text is never transparent. */
  @keyframes hero-line { from { transform: translateY(.42em); } to { transform: none; } }
  @keyframes hero-line-sm { from { transform: translateY(.25em); } to { transform: none; } }
  @keyframes hero-photo { from { clip-path: inset(22% 0 0 0); transform: scale(1.04); } to { clip-path: inset(0 0 0 0); transform: none; } }
  :global(.js) .hero__line > span { animation: hero-line-sm 300ms var(--ease-out) both; }
  :global(.js) .hero__line:nth-child(2) > span { animation-delay: 80ms; }
  @media (min-width: 768px) {
    :global(.js) .hero__line > span { animation: hero-line 700ms var(--ease-out) both; }
    :global(.js) .hero__line:nth-child(2) > span { animation-delay: 80ms; }
    :global(.js) .hero__frame :global(img) { animation: hero-photo 800ms var(--ease-out) 120ms both; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero__line > span, :global(.js) .hero__frame :global(img) { animation: none !important; }
    .inv-link::before { transition: none; }
  }
  @media (hover: none) {
    .inv-link::before { transition: none; }
  }
</style>
