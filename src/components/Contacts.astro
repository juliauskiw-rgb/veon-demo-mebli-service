---
// Contacts (concept §5 «Контакти»): the two numbers as the largest type after the H1, messengers, e-mail, hours,
// the two workshops by name (no exact address on the client's site, C-004) and one calm inactive callback form.
import Icon from "./Icon.astro";
import { contacts } from "../data/site";
---
<section id="kontakty" class="section contacts" aria-labelledby="kontakty-title">
  <div class="container">
    <h2 id="kontakty-title" class="h2" data-reveal>Контакти</h2>

    <div class="contacts__grid">
      <div class="contacts__main" data-reveal style="--reveal-delay:60ms">
        <ul class="phones">
          <li><a class="phone tnum" href={contacts.phoneMain.href}>{contacts.phoneMain.display}</a></li>
          <li><a class="phone tnum" href={contacts.phoneSecond.href}>{contacts.phoneSecond.display}</a></li>
        </ul>
        <p class="contacts__hours">{contacts.hours}</p>
        <div class="contacts__msg" data-rec="R-002">
          <a class="btn btn--primary" href={contacts.viber}><Icon name="viber" />Написати у Viber</a>
          <a class="btn btn--secondary" href={contacts.whatsapp}><Icon name="whatsapp" />WhatsApp</a>
        </div>
        <p class="contacts__mail"><Icon name="mail" /><a class="text-link" href={contacts.email.href}>{contacts.email.display}</a></p>

        <div class="places">
          <h3 class="places__title">Майстерні</h3>
          <ul>
            <li>На Науковій</li>
            <li>У районі Галицького перехрестя</li>
          </ul>
          <p class="places__note">Точну адресу уточнюйте по телефону. Виїжджаємо в усі райони Львова та області.</p>
        </div>
      </div>

      <div class="callback" data-reveal style="--reveal-delay:120ms">
        <h3 class="callback__title" id="callback-title">Передзвонимо вам</h3>
        <fieldset class="callback__fields" disabled aria-labelledby="callback-title" aria-describedby="callback-hint">
          <div class="field">
            <label for="cb-name">Ім'я</label>
            <input id="cb-name" name="name" type="text" autocomplete="name" />
          </div>
          <div class="field">
            <label for="cb-phone">Телефон</label>
            <input id="cb-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
          </div>
          <button class="btn btn--secondary callback__btn" type="button" disabled aria-describedby="callback-hint">Передзвоніть мені</button>
        </fieldset>
        <p class="callback__hint" id="callback-hint">Онлайн-заявка з'явиться в повній версії сайту.</p>
        <p class="callback__now">
          А поки — <a class="text-link tnum" href={contacts.phoneMain.href}>{contacts.phoneMain.display}</a> або <a class="text-link" href={contacts.viber}>Viber</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts__grid { display: grid; gap: var(--s-6); margin-top: var(--s-5); }
  .phones { display: grid; gap: var(--s-1); }
  .phone { display: inline-block; font-family: var(--font-body); font-size: clamp(2.125rem, 1.3rem + 3.6vw, 4rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.02em; text-decoration: none; white-space: nowrap; transition: color var(--dur-fast) var(--ease-out); }
  .phone:hover { color: var(--color-link); }
  .contacts__hours { margin-top: var(--s-3); font-size: var(--fs-2); }
  .contacts__msg { margin-top: var(--s-4); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-1); }
  .contacts__msg .btn { padding-inline: var(--s-2); }
  .contacts__mail { margin-top: var(--s-3); display: flex; align-items: center; gap: .625rem; min-height: var(--tap); overflow-wrap: anywhere; }
  .contacts__mail :global(svg) { width: 1.25rem; height: 1.25rem; flex: none; color: var(--color-muted); }
  .places { margin-top: var(--s-5); padding-top: var(--s-3); border-top: 1px solid var(--color-line); }
  .places__title { font-size: var(--fs-3); font-weight: 500; }
  .places ul { margin-top: var(--s-2); display: grid; gap: .25rem; font-family: var(--font-display); font-size: var(--fs-4); line-height: 1.2; }
  .places__note { margin-top: var(--s-2); color: var(--color-muted); max-width: 40ch; }

  .callback { align-self: start; padding: var(--s-4); border: 1px solid var(--color-line); border-radius: var(--radius); }
  .callback__title { font-size: var(--fs-3); font-weight: 500; }
  .callback__fields { margin: var(--s-3) 0 0; padding: 0; border: 0; display: grid; gap: var(--s-2); min-width: 0; }
  .field { display: grid; gap: .375rem; }
  .field label { font-size: var(--fs-cap); color: var(--color-muted); }
  .field input { width: 100%; min-height: 3rem; padding: 0 .875rem; font: inherit; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-border-input); border-radius: var(--radius); }
  .field input:disabled { cursor: not-allowed; opacity: .6; }
  .callback__btn { width: 100%; margin-top: var(--s-1); }
  .callback__hint { margin-top: var(--s-2); font-size: var(--fs-cap); color: var(--color-muted); }
  .callback__now { margin-top: var(--s-1); font-size: var(--fs-cap); }

  @media (min-width: 768px) {
    .contacts__msg { display: flex; flex-wrap: wrap; }
  }
  @media (min-width: 1024px) {
    .contacts__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); }
    .contacts__main { grid-column: 1 / span 7; }
    .callback { grid-column: 9 / -1; }
  }
</style>
